FROM ubuntu:22.04

RUN apt-get update && \
    (apt-get install -y \
    docker.io \
    git \
    curl \
    wget \
    python3 \
    python3-pip || true) && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* || true

RUN pip install --no-cache-dir docker-compose

WORKDIR /app

COPY entrypoint-wrapper.sh /app/entrypoint-wrapper.sh
RUN chmod +x /app/entrypoint-wrapper.sh

ENTRYPOINT ["/app/entrypoint-wrapper.sh"]
