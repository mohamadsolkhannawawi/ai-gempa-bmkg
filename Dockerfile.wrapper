FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
# Pin Docker API version to match DinD daemon (v1.41).
# Host docker CLI may be newer (v1.52) and would reject calls otherwise.
ENV DOCKER_API_VERSION=1.41

RUN apt-get update 2>/dev/null || true && \
    apt-get install -y --no-install-recommends \
    docker.io \
    docker-compose \
    git \
    curl \
    wget \
    python3 \
    python3-pip \
    python3-setuptools \
    python3-wheel && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* || true

WORKDIR /app

COPY entrypoint-wrapper.sh /app/entrypoint-wrapper.sh
RUN chmod +x /app/entrypoint-wrapper.sh

ENTRYPOINT ["/app/entrypoint-wrapper.sh"]
