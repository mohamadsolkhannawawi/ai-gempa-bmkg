# SISPRO-TEWS Admin Seed Configuration
# IMPORTANT: Copy this file to .env.seed and fill with secure credentials
# DO NOT commit .env.seed to version control

# ========================================
# MongoDB Connection
# ========================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=sispro-tews

# MongoDB connection retry settings
MONGO_CONNECT_RETRIES=10
MONGO_CONNECT_RETRY_DELAY=3

# ========================================
# Initial Admin User Credentials
# ========================================
# These credentials are used ONLY for seeding the initial admin user
# Change these to secure values in production

# Username for initial admin (alphanumeric, no spaces)
INITIAL_ADMIN_USERNAME=admin

# Password for initial admin (minimum 8 chars, use strong password in production)
# Example secure password: $(openssl rand -base64 32)
INITIAL_ADMIN_PASSWORD=ChangeMe123!SecurePassword

# Optional: Admin email
INITIAL_ADMIN_EMAIL=admin@bmkg.go.id

# Optional: Admin full name
INITIAL_ADMIN_FULLNAME=Administrator BMKG

# Optional: Admin region
INITIAL_ADMIN_REGION=Indonesia

# =============================================================================
# Storage & Retention Policy Configuration
# Ideal for Server riset-01: 16 Cores, 64 GB RAM, 2 TB Storage
# =============================================================================
# Waveform MiniSEED archive directory path (mount location)
ARCHIVE_LOCATION=/mnt/archive

# MiniSEED archive retention in days (Ideal for 2TB: 90 days, ~300-500GB)
ARCHIVE_RETENTION_DAYS=90

# Application log files (.log) retention in days (Ideal: 14 days)
LOG_RETENTION_DAYS=14

# MongoDB AI raw phase picks retention in days (Ideal: 30 days)
DB_PICKS_RETENTION_DAYS=30

# Maximum size for active rotating log files in MB (e.g. 50 MB)
MAX_LOG_SIZE_MB=50

# Docker system prune: automatically remove unused dangling images & cache
ENABLE_DOCKER_PRUNE=true
DOCKER_PRUNE_UNTIL=168h

# Disk alert threshold percentage (Alert if usage exceeds this percentage)
DISK_USAGE_ALERT_THRESHOLD=85

# ========================================
# Security Notes
# ========================================
# 1. Change INITIAL_ADMIN_PASSWORD to a strong password (min 16 chars recommended)
# 2. Use password manager to generate secure passwords
# 3. This file should have restricted permissions: chmod 600 .env.seed
# 4. After first login, change the admin password via UI
# 5. DO NOT commit this file to git (already in .gitignore)

