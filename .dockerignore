# Exclude data directories and caches from Docker build context
**/data/
**/logs/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.git/
.gitignore
*.md
!DEPLOYMENT_WRAPPER.md
.env
.envs/
node_modules/
venv/
.vscode/
.idea/
*.egg-info/
dist/
build/

# MongoDB WiredTiger data files
AI-TEWS/requirements/data/
AI-TEWS/requirements/logs/

# Sispro-TEWS module logs and data
sispro-tews/*/logs/
sispro-tews/*/data/
